# Normalize line endings: LF in the repository, LF on checkout (no CRLF churn).
* text=auto

*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ps1   text eol=lf
*.sh    text eol=lf

# Binary files are never touched.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.tgz   binary
